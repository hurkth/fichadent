# Supabase > Project Settings > API
# Solo la URL, sin corchetes ni texto extra:
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Llave pública (sb_publishable_…). También se acepta NEXT_PUBLIC_SUPABASE_ANON_KEY (formato antiguo).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# NUNCA pongas aquí la secret / service_role key.
# WhatsApp de Fichadent (9 dígitos): "Activar mi plan" y "Te ayudamos a digitalizar tus historias".
NEXT_PUBLIC_SALES_WHATSAPP=987654321
